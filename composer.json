{
    "name": "motomedialab/impersonate",
    "description": "A user impersonation package for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "MotoMediaLab",
            "email": "hello@motomedialab.com"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4|^8.5",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.34|^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^2.3|^3.0|^4.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0",
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.29",
        "driftingly/rector-laravel": "^2.5"
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "autoload": {
        "psr-4": {
            "Motomedialab\\Impersonate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Motomedialab\\Impersonate\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Motomedialab\\Impersonate\\ImpersonationServiceProvider"
            ],
            "aliases": {
                "Impersonate": "Motomedialab\\Impersonate\\Facades\\Impersonate"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
